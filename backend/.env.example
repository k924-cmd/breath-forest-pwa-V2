# 真实模型适配器（DeepSeek）本地配置示例。
# 使用方法：复制为 backend/.env 并填入真实值；backend/.env 已被 .gitignore 忽略，禁止提交。
DEEPSEEK_ENABLED=1
DEEPSEEK_API_KEY=
DEEPSEEK_ENDPOINT=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=512
DEEPSEEK_TIMEOUT_MS=15000

# 实时搜索适配器（Tavily）本地配置示例。
# 填入真实 key 后，weather/室外类实时查询会走 Tavily；key 留空时保持拒绝路径。
TAVILY_ENABLED=1
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=3
TAVILY_TIMEOUT_MS=10000
